{% assign items = include.items | default: site.news | sort: 'date' | reverse %}
<ul class="news-list">
  {% for item in items limit: include.limit %}
    <li><time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %d, %Y' }}</time><div>{% if item.inline %}{{ item.content }}{% else %}<a href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}</div></li>
  {% endfor %}
</ul>
