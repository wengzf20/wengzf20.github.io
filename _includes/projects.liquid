<article class="project-card"><a href="{{ project.url | relative_url }}"><img src="{{ project.img | relative_url }}" alt="{{ project.title | escape }}" loading="lazy"><div class="card-body"><h2>{{ project.title }}</h2><p>{{ project.description }}</p></div></a>{% if project.github %}<a class="project-code" href="{{ project.github }}">Code repository</a>{% endif %}</article>