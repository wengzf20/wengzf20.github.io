---
---
<div class="publication" id="{{ entry.key }}">
<div class="publication-media">{% if entry.preview %}<img class="publication-preview" src="{% if entry.preview contains '://' %}{{ entry.preview }}{% else %}{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}{% endif %}" alt="Figure from {{ entry.title | strip_html | escape }}" loading="lazy">{% elsif entry.abbr %}<span class="publication-abbr" title="{{ entry.booktitle | default: entry.journal | escape }}">{{ entry.abbr }}</span>{% endif %}</div>
<div><h3>{{ entry.title }}</h3><p class="authors">{% for author in entry.author_array %}{% if author.last == 'Weng' %}<strong>{{ author.first }} {{ author.last }}</strong>{% else %}{{ author.first }} {{ author.last }}{% endif %}{% unless forloop.last %}, {% endunless %}{% endfor %}</p>
<p><em>{{ entry.journal | default: entry.booktitle }}</em>{% if entry.year %}, {{ entry.year }}{% endif %} {{ entry.note }}</p>
<div class="publication-links">{% if entry.bibtex_show %}<button type="button" class="bib-toggle" aria-expanded="false" aria-controls="bib-{{ entry.key }}">BIB</button>{% endif %}{% if entry.arxiv %}<a href="https://arxiv.org/abs/{{ entry.arxiv }}">arXiv</a>{% endif %}
{% assign fields = 'html,pdf,supp,video,blog,code,poster,slides,website' | split: ',' %}{% for field in fields %}{% assign link = entry[field] %}{% if link %}<a href="{% if link contains '://' or link contains '/' %}{{ link }}{% else %}{{ link | prepend: '/assets/pdf/' | relative_url }}{% endif %}">{{ field | upcase }}</a>{% endif %}{% endfor %}
{% if entry.citation_count %}{% capture citation_label %}Cited by {{ entry.citation_count }}{% endcapture %}{% if entry.scholar_url %}<a class="citation-count" href="{{ entry.scholar_url | escape }}" data-tooltip="{{ citation_label | escape }}" aria-label="{{ citation_label | escape }}">{{ entry.citation_count }}</a>{% else %}<span class="citation-count" tabindex="0" data-tooltip="{{ citation_label | escape }}" aria-label="{{ citation_label | escape }}">{{ entry.citation_count }}</span>{% endif %}{% endif %}</div>
{% if entry.abstract %}<details><summary>Abstract</summary><p>{{ entry.abstract }}</p></details>{% endif %}
{% if entry.bibtex_show %}<div class="bibtex-panel" id="bib-{{ entry.key }}" hidden>{% highlight bibtex %}{{ entry.bibtex }}{% endhighlight %}</div>{% endif %}</div></div>
