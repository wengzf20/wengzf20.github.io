<!doctype html>
<html lang="{{ site.lang }}">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page.title | escape }} · {{ site.title }}</title>
<meta name="description" content="{{ page.description | default: site.description | strip_html | escape }}">
<link rel="canonical" href="{{ page.url | absolute_url }}">
<link rel="icon" href="{{ '/assets/img/site-logo.png' | relative_url }}">
<link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}">
<script src="{{ '/assets/js/site.js' | relative_url }}" defer></script>
{% feed_meta %}
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header"><nav class="site-nav" aria-label="Main navigation">
<a class="brand" href="{{ '/' | relative_url }}">Zifeng <strong>Weng</strong></a>
<div class="nav-links"><a href="{{ '/' | relative_url }}">Home</a>{% assign navigation = site.pages | where: 'nav', true | sort: 'nav_order' %}{% for item in navigation %}<a href="{{ item.url | relative_url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}<button type="button" id="theme-toggle" aria-label="Toggle color theme">◐</button></div>
</nav></header>
<main id="main" class="{% if page.layout == 'post' %}article-shell{% elsif page.wide or page.layout == 'post-archive' %}wide-page{% else %}standard-page{% endif %}">{{ content }}</main>
<footer class="site-footer"><p>© {{ 'now' | date: '%Y' }} Zifeng Weng · Built with Jekyll · Hosted on GitHub Pages</p>{% if page.collection == 'posts' or page.url == '/Blog/' or page.layout == 'post-archive' %}<a href="https://buymeacoffee.com/zfweng">Buy me a coffee</a>{% endif %}</footer>
</body></html>
