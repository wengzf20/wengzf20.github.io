---
layout: default
---
<h1>Zifeng <strong>Weng</strong></h1>
<aside class="profile">
  <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Zifeng Weng">
  <ul class="profile-links">
    {% for link in page.profile.links %}
      <li{% if link.full_row %} class="full-row"{% endif %}><a href="{{ link.url }}">{% assign icon_path = link.icon | prepend: 'icons/' | append: '.svg' %}{% include {{ icon_path }} %}<span>{{ link.label }}</span></a></li>
    {% endfor %}
  </ul>
</aside>
<div class="bio">{{ content }}</div>
<section class="clear home-updates"><h2><a href="{{ '/news/' | relative_url }}">News</a></h2>{% include news.liquid limit=3 %}</section>
<section class="home-updates"><h2><a href="{{ '/Blog/' | relative_url }}">Latest Posts</a></h2>{% include news.liquid items=site.posts limit=3 %}</section>
<div class="social">
  <nav class="social-icons" aria-label="Contact and academic profiles">
    <a href="mailto:{{ site.email }}" aria-label="Email" title="Email">{% include icons/email.svg %}</a>
    <a href="https://orcid.org/0000-0001-6797-7594" aria-label="ORCID" title="ORCID">{% include icons/orcid.svg %}</a>
    <a href="https://scholar.google.com/citations?user=iQ73Y8UAAAAJ" aria-label="Google Scholar" title="Google Scholar">{% include icons/scholar.svg %}</a>
    <a href="https://www.researchgate.net/profile/Zifeng-Weng" aria-label="ResearchGate" title="ResearchGate">{% include icons/researchgate.svg %}</a>
    <a href="https://github.com/wengzf20" aria-label="GitHub" title="GitHub">{% include icons/github.svg %}</a>
    <a href="https://www.linkedin.com/in/zifeng-weng-311316291" aria-label="LinkedIn" title="LinkedIn">{% include icons/linkedin.svg %}</a>
  </nav>
  <p class="contact-note">Stay Hungry Stay Foolish</p>
</div>
