---
layout: default
---
<aside class="contents" aria-label="Article contents" hidden><details open><summary>Contents</summary><nav id="article-toc"></nav></details></aside>
<article class="article-content">
<header><h1>{{ page.title | default: 'News' }}</h1>{% if page.collection == 'posts' or page.collection == 'news' %}<p class="meta">{{ page.date | date: '%B %d, %Y' }}</p>{% endif %}
{% if page.collection == 'posts' %}{% include post-taxonomy.liquid item=page %}{% endif %}</header>
<div id="article-body">{{ content }}</div>
</article>
